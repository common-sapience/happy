# Development values for `pnpm standalone` in this package. The deployed form does not read this
# file: it takes the same variables from the deployment's env file (see the harness repository's
# deploy/ directory), and its master secret never lives in a checked-in file.

DB_PROVIDER=pglite
HANDY_MASTER_SECRET=local-development-only-not-a-secret
PORT=3005
NODE_ENV=development

# Writes a full debug log under .logs/. Development only.
# DANGEROUSLY_LOG_TO_SERVER_FOR_AI_AUTO_DEBUGGING=true

# The hosted form instead of the standalone one: an external database, and optionally Redis for
# cross-process fan-out and S3 for uploaded files. A single instance needs neither (HA-01).
# DB_PROVIDER=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/handy
# REDIS_URL=redis://localhost:6379
# S3_HOST=localhost
# S3_PORT=9000
# S3_USE_SSL=false
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=happy
# S3_PUBLIC_URL=http://localhost:9000/happy
